# Copy this file to .env and set values for your OpenAI-compatible provider.
# Do not commit this file with real credentials.
RAG_API_KEY=
RAG_API_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=
RAG_LLM_MODEL=
RAG_CHUNK_MAX_CHARS=1200

# Choose sqlite by default; pgvector is optional.
RAG_VECTOR_BACKEND=sqlite
RAG_VECTOR_DB_PATH=data/vectors.sqlite3
RAG_DATABASE_URL=postgresql://rag:rag_dev_password@postgres:5432/rag

# Local API and optional PostgreSQL profile ports.
RAG_PORT=8000
PGVECTOR_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
