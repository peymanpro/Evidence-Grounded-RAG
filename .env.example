# Copy this file to .env and set provider details before enabling RAG.
# Never commit the populated .env file. The password below is only a local example.
RAG_API_KEY=
RAG_API_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=
RAG_LLM_MODEL=
RAG_PORT=8000
RAG_VECTOR_TABLE_PREFIX=rag

# Local Compose PostgreSQL settings (use URL-safe characters for the password).
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=local-dev-change-me
